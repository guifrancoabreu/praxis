apps/*/android/app/build/
apps/*/android/local.properties
apps/*/android/.idea/
*.apk
*.aab
release/

# configuração local
.claude/

# iOS local build and Xcode state
ios/.build/
ios/.swiftpm/
*.xcuserstate
xcuserdata/
