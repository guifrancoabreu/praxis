<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window theme only covers launch; every screen is drawn by Compose. -->
    <style name="Theme.Praxis" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/praxis_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
